.room-heading{display:flex;align-items:center;justify-content:space-between}.share{font-size:24rpx;padding:10rpx 18rpx;background:transparent}.room-title{font-family:"Songti SC",serif;font-size:44rpx;line-height:1.4;font-weight:600}.phase-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:24rpx 0 16rpx}.clock{font-size:56rpx;font-variant-numeric:tabular-nums;color:#2859a5;white-space:nowrap}.clock text{font-size:23rpx;margin-left:8rpx}.seats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.seat{background:#fff;border:2rpx solid #cad5e1;border-radius:16rpx;padding:22rpx 8rpx;text-align:center;min-width:0}.avatar{width:76rpx;height:76rpx;border-radius:50%;background:#eef2f6;color:#2859a5;margin:0 auto 12rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:600}.seat-name{font-size:24rpx;font-weight:600;overflow-wrap:anywhere}.seat-status{font-size:21rpx;color:#56697b;margin-top:5rpx}.empty{border-style:dashed;background:transparent}.out .avatar{color:#718395;text-decoration:line-through}.selected{border-color:#2859a5;background:#e3ecf8}.selectable .avatar{outline:2rpx dashed #2859a5;outline-offset:5rpx}.speaking{border-color:#2859a5}.speaking .avatar{background:#2859a5;color:#fff}.identity{border-left:5rpx solid #2859a5;padding:8rpx 0 8rpx 24rpx;font-size:26rpx}.private-note{background:#e3ecf8;padding:14rpx;margin-top:12rpx;border-radius:8rpx}.record{padding:20rpx 0;border-bottom:1rpx solid #cad5e1;font-size:24rpx;overflow-wrap:anywhere}.voice-panel .section-title{font-size:27rpx}
