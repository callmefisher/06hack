page{background:#eef2f6;color:#182c41;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.65}view,text,input,button{box-sizing:border-box}button{font-size:27rpx;line-height:1.5;border-radius:12rpx;padding:24rpx 28rpx;background:#fff;color:#182c41;margin:0}button::after{border:1rpx solid #cad5e1}button[disabled]{background:#e7edf3;color:#718395}.primary{background:#2859a5;color:#fff}.primary::after{border-color:#2859a5}.page{padding:36rpx 32rpx calc(42rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#2859a5;font-weight:600}.title{font-family:"Songti SC",serif;font-size:60rpx;line-height:1.35;font-weight:600;margin:18rpx 0 24rpx}.subtitle{font-size:28rpx;color:#56697b}.section{margin-top:32rpx}.panel{background:#fff;border:1rpx solid #cad5e1;border-radius:20rpx;padding:28rpx}.label{font-size:24rpx;color:#56697b;margin-bottom:10rpx}.small{font-size:23rpx;color:#56697b}.notice{border-left:5rpx solid #2859a5;padding-left:20rpx;font-size:25rpx;color:#56697b}.error{background:#fff;border:1rpx solid #2859a5;border-radius:10rpx;padding:20rpx;margin-top:20rpx;color:#182c41}.row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.row>button{flex:1}.input{height:96rpx;background:#f2f5f9;border:1rpx solid #cad5e1;border-radius:10rpx;padding:18rpx 24rpx;width:100%;color:#182c41}.divider{height:1rpx;background:#cad5e1;margin:26rpx 0}.section-title{font-size:32rpx;font-weight:600;margin-bottom:16rpx}.link-button{background:transparent;font-size:24rpx;color:#2859a5;padding:12rpx 0}.link-button::after{border:0}.badge{font-size:21rpx;border:1rpx solid #cad5e1;padding:6rpx 12rpx;border-radius:6rpx;display:inline-block}.dev-banner{font-size:23rpx;color:#2859a5;padding:14rpx 18rpx;border:1rpx dashed #2859a5;border-radius:8rpx;margin-bottom:28rpx}.rules{font-size:25rpx;line-height:1.9;color:#56697b;white-space:pre-wrap}
